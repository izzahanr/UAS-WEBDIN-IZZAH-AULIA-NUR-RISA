# ============================================
#  Backend Environment Variables — TEMPLATE
#  Salin file ini menjadi .env dan isi nilainya
# ============================================

PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=inventaris_lab

JWT_SECRET=ganti_dengan_string_rahasia_yang_panjang
JWT_EXPIRES_IN=7d

UPLOAD_MAX_SIZE=2097152
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,webp
UPLOAD_PATH=uploads/
